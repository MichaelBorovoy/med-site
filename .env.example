# Copy this file to .env.local and fill in values.
# Never commit real usernames or passwords.

# Required: secret used to sign session cookies (use a long random string)
SESSION_SECRET=

# Bootstrap admin account (created on first seed / first app start)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional demo patient account for local testing
DEMO_PATIENT_USERNAME=
DEMO_PATIENT_PASSWORD=
DEMO_PATIENT_FULL_NAME=Alex Rivera
DEMO_PATIENT_EMAIL=alex.rivera@example.com
DEMO_PATIENT_DATE_OF_BIRTH=1990-04-12

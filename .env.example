# Copy this file to .env.local (local) or /opt/harborcare/.env (Hetzner).
# Never commit real usernames or passwords.

# --- Hetzner / Docker production (required on the VPS) ---
# DOMAIN=care.example.com
# ACME_EMAIL=you@example.com
# DATA_DIR=/app/data

# Required: secret used to sign session cookies (use a long random string)
SESSION_SECRET=

# Bootstrap admin account (created on first app start)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional demo patient account for local testing
DEMO_PATIENT_USERNAME=
DEMO_PATIENT_PASSWORD=
DEMO_PATIENT_FULL_NAME=Alex Rivera
DEMO_PATIENT_EMAIL=alex.rivera@example.com
DEMO_PATIENT_DATE_OF_BIRTH=1990-04-12

# Optional demo doctor account (linked to a doctor directory profile)
DEMO_DOCTOR_USERNAME=
DEMO_DOCTOR_PASSWORD=
DEMO_DOCTOR_FULL_NAME=Dr. Maya Chen

# Optional demo coordinator account
DEMO_COORDINATOR_USERNAME=
DEMO_COORDINATOR_PASSWORD=

# Optional: seed up to N doctors across the 5 clinics for local scale testing (max 1000)
# DEMO_SCALE_DOCTORS=1000
